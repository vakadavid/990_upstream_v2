# ExtremeKernel config file for enabling KSU

# Enable KSU
CONFIG_KSU=y
CONFIG_KSU_WITH_KPROBES=n
CONFIG_KSU_KPROBES_HOOK=n
CONFIG_KPM=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_KSU_ALLOWLIST_WORKAROUND=y

# Enable SuSFS 2.0
CONFIG_KSU_SUSFS=y

# Mountify
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_XATTR=y

# EOF

